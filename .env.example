# Environment Variables Template
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# ═══════════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════

# PostgreSQL connection string (leave empty for JSON demo mode)
# Format: postgresql://username:password@hostname:5432/database_name
# Example: postgresql://analytics:secure_password_123@postgres:5432/supply_chain_data_lake
DATABASE_URL=

# ═══════════════════════════════════════════════════════════════════
# SECURITY & AUTHENTICATION
# ═══════════════════════════════════════════════════════════════════

# Flask secret key for session encryption (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your_secret_key_here_change_in_production

# Enable debug mode (NEVER true in production!)
FLASK_DEBUG=0

# Environment (development, staging, production)
FLASK_ENV=production

# ═══════════════════════════════════════════════════════════════════
# EXTERNAL SERVICES
# ═══════════════════════════════════════════════════════════════════

# Groq API key for LLM-based parameter extraction
# Get from: https://console.groq.com/
GROQ_API_KEY=gsk_xxx_your_api_key_here

# ═══════════════════════════════════════════════════════════════════
# APPLICATION CONFIGURATION
# ═══════════════════════════════════════════════════════════════════

# Port for Flask application
PORT=5000

# Number of Gunicorn workers (CPU cores * 2 + 1 recommended)
GUNICORN_WORKERS=4

# Request timeout in seconds
REQUEST_TIMEOUT=120

# ═══════════════════════════════════════════════════════════════════
# LOGGING & MONITORING
# ═══════════════════════════════════════════════════════════════════

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# ═══════════════════════════════════════════════════════════════════
# ADVANCED OPTIONS
# ═══════════════════════════════════════════════════════════════════

# Redis connection for caching (optional)
REDIS_URL=redis://localhost:6379/0

# Spark master URL for distributed processing (optional)
SPARK_MASTER=spark://localhost:7077

# Enable CORS for cross-origin requests
CORS_ORIGINS=*

# Maximum upload file size (in bytes)
MAX_UPLOAD_SIZE=52428800  # 50MB

# ═══════════════════════════════════════════════════════════════════
# DOCKER COMPOSE SPECIFIC
# ═══════════════════════════════════════════════════════════════════

# PostgreSQL admin credentials
POSTGRES_USER=analytics
POSTGRES_PASSWORD=secure_password_123
POSTGRES_DB=supply_chain_data_lake

# Redis configuration (inside docker-compose)
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka bootstrap servers (inside docker-compose)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ═══════════════════════════════════════════════════════════════════
# ADMIN USER CREDENTIALS (Development Only!)
# WARNING: In production, use environment variables ONLY
# ═══════════════════════════════════════════════════════════════════

ADMIN_USERNAME=dilnazshanova
ADMIN_PASSWORD=Aa1234
